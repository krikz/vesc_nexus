<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vesc_nexus</name>
  <version>2.1.0</version>
  <description>
    ros2_control hardware interface for VESC motor controllers over SocketCAN.
    Drives several VESC on one CAN bus in duty-cycle or closed-loop RPM mode and
    reports wheel velocity, position, motor current and battery voltage.
  </description>

  <maintainer email="krikz@users.noreply.github.com">krikz</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/krikz/vesc_nexus</url>
  <url type="bugtracker">https://github.com/krikz/vesc_nexus/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>vesc_msgs</depend>

  <exec_depend>controller_manager</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/vesc_nexus_plugins.xml" />
  </export>
</package>
