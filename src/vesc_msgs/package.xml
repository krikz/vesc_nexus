<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vesc_msgs</name>
  <version>1.1.0</version>
  <description>
    ROS 2 message definitions for VESC motor controller telemetry.
    VescState is derived from the f1tenth/vesc ROS 1 package and extended for vesc_nexus.
  </description>

  <maintainer email="krikz@users.noreply.github.com">krikz</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/krikz/vesc_nexus</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
